<Window x:Class="CodexWeeklyMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CodexWeeklyMonitor.Localization"
        Title="{loc:Str app.title}"
        Icon="Assets/app.png"
        Width="406"
        Height="432"
        MinWidth="406"
        MinHeight="432"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        Background="#FF1A1E25"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
        Keeps the real WS_CAPTION on the HWND while hiding the non-client area. Windows only runs
        the minimise/restore scale animation for windows that have a caption, so WindowStyle="None"
        (which strips it) left the window popping in and out with no animation at all.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#93A0AE" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#697582" />
        <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#20FFFFFF" />

        <!--
            One base style for every header action so height, corner radius, spacing and the
            hover/pressed treatment are identical; only the width differs between the two text
            buttons and the three icon buttons.
        -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="#8E9AA7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#16FFFFFF" />
                                <Setter Property="Foreground" Value="#E7EDF4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#F5F8FC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Both labelled buttons share a fixed width so the ▾/▴ swap never shifts the row. -->
        <Style x:Key="HeaderTextButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Width" Value="56" />
        </Style>

        <!-- Fluent glyphs keep the three icons optically equal; ad-hoc characters did not. -->
        <Style x:Key="HeaderGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="RoundedProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="#7EE787" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2.5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryBarToolTipStyle" TargetType="{x:Type ToolTip}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Placement" Value="MousePoint" />
            <Setter Property="HorizontalOffset" Value="10" />
            <Setter Property="VerticalOffset" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="#E7EDF4" />
            <Setter Property="Background" Value="#FF242A32" />
            <Setter Property="BorderBrush" Value="#46515D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border x:Name="TooltipChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Direction="270"
                                                  ShadowDepth="3"
                                                  Opacity="0.42"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same control and style as the card's menu, so both open identically. -->
        <ContextMenu x:Key="TrayContextMenu"
                     Style="{DynamicResource ModernContextMenuStyle}"
                     Opened="TrayContextMenu_Opened">
            <MenuItem Header="{loc:Str menu.showWindow}"
                      Style="{DynamicResource ModernMenuItemStyle}"
                      FontWeight="SemiBold"
                      Click="TrayShowMenuItem_Click" />
            <MenuItem Header="{loc:Str menu.refresh}"
                      Style="{DynamicResource ModernMenuItemStyle}"
                      Click="RefreshMenuItem_Click" />
            <Separator Style="{DynamicResource ModernMenuSeparatorStyle}" />
            <!-- Resources have no name scope, so these are located by Tag when the menu opens. -->
            <MenuItem Tag="codex"
                      Style="{DynamicResource ModernMenuItemStyle}"
                      IsEnabled="False" />
            <MenuItem Tag="claude"
                      Style="{DynamicResource ModernMenuItemStyle}"
                      IsEnabled="False" />
            <Separator Style="{DynamicResource ModernMenuSeparatorStyle}" />
            <MenuItem Header="{loc:Str menu.exit}"
                      Style="{DynamicResource ModernMenuItemStyle}"
                      Click="TrayExitMenuItem_Click" />
        </ContextMenu>

        <Style x:Key="ProviderTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#778493" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#10FFFFFF" />
                                <Setter Property="Foreground" Value="#B9C4CF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#28FFFFFF" />
                                <Setter Property="Foreground" Value="#EDF3F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        The window itself is the card now: no transparency layer, so Windows can run its native
        minimise/restore animation. Rounded corners and the shadow come from DWM instead.
    -->
    <Grid>
        <Border x:Name="Card"
                Padding="15,14"
                Background="Transparent"
                BorderThickness="0"
                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                             Opened="CardContextMenu_Opened">
                    <MenuItem Header="{loc:Str menu.refresh}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              FontWeight="SemiBold"
                              Click="RefreshMenuItem_Click" />
                    <MenuItem x:Name="DetailsMenuItem"
                              Header="{loc:Str menu.expandDetails}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              Click="DetailsMenuItem_Click" />
                    <MenuItem x:Name="HistoryMenuItem"
                              Header="{loc:Str menu.expandHistory}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              IsEnabled="False"
                              Click="HistoryMenuItem_Click" />
                    <MenuItem x:Name="TopmostMenuItem"
                              Header="{loc:Str menu.topmost}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="TopmostMenuItem_Click" />
                    <MenuItem Header="{loc:Str menu.minimizeTaskbar}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              Click="MinimizeMenuItem_Click" />
                    <MenuItem Header="{loc:Str menu.hideTray}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              Click="HideMenuItem_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="78" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="8" />
                    <RowDefinition x:Name="ExpandRow" Height="0" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            Background="#14FFFFFF"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Image x:Name="AppMarkImage"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="Assets/app.png" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitleText"
                                   Text="{loc:Str app.title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F5F9" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="StatusDot"
                                     Width="5"
                                     Height="5"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="#F0B95C" />
                            <TextBlock x:Name="ConnectionText"
                                       Text="{loc:Str conn.connecting}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="DetailsButton"
                                Style="{StaticResource HeaderTextButtonStyle}"
                                AutomationProperties.Name="{loc:Str header.toggleDetails}"
                                Click="DetailsButton_Click">
                            <TextBlock x:Name="DetailsButtonText"
                                       Text="{loc:Str header.details}"
                                       Style="{StaticResource HeaderLabelStyle}" />
                        </Button>
                        <Button x:Name="HistoryButton"
                                Style="{StaticResource HeaderTextButtonStyle}"
                                IsEnabled="False"
                                AutomationProperties.Name="{loc:Str header.toggleHistory}"
                                Click="HistoryButton_Click">
                            <TextBlock x:Name="HistoryButtonText"
                                       Text="{loc:Str header.history}"
                                       Style="{StaticResource HeaderLabelStyle}" />
                        </Button>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource HeaderButtonStyle}"
                                AutomationProperties.Name="{loc:Str header.refresh}"
                                Click="RefreshButton_Click">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource HeaderGlyphStyle}" />
                        </Button>
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource HeaderButtonStyle}"
                                AutomationProperties.Name="{loc:Str header.minimize}"
                                Click="MinimizeButton_Click">
                            <TextBlock Text="&#xE921;" Style="{StaticResource HeaderGlyphStyle}" />
                        </Button>
                        <Button x:Name="CloseToTrayButton"
                                Style="{StaticResource HeaderButtonStyle}"
                                AutomationProperties.Name="{loc:Str header.hide}"
                                Click="CloseButton_Click">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource HeaderGlyphStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="11,9"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="15" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{loc:Str card.fiveHour}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="FiveHourRemainingText"
                                           Text="--%"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#F5F7FA" />
                            </Grid>
                            <ProgressBar x:Name="FiveHourProgress"
                                         Grid.Row="2"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Style="{StaticResource RoundedProgressStyle}" />
                            <Grid Grid.Row="4">
                                <TextBlock x:Name="FiveHourUsedText"
                                           Text="已用 --%"
                                           FontSize="9.5"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock x:Name="FiveHourResetText"
                                           Text="{loc:Str card.waitingData}"
                                           HorizontalAlignment="Right"
                                           FontSize="9.5"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="11,9"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="15" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{loc:Str card.weekly}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="WeeklyRemainingText"
                                           Text="--%"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#F5F7FA" />
                            </Grid>
                            <ProgressBar x:Name="WeeklyProgress"
                                         Grid.Row="2"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Style="{StaticResource RoundedProgressStyle}" />
                            <Grid Grid.Row="4">
                                <TextBlock x:Name="WeeklyUsedText"
                                           Text="已用 --%"
                                           FontSize="9.5"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock x:Name="WeeklyResetText"
                                           Text="{loc:Str card.waitingData}"
                                           HorizontalAlignment="Right"
                                           FontSize="9.5"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Padding="11,7"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <TextBlock x:Name="BalanceCaption"
                                       Text="{loc:Str card.balance}"
                                       VerticalAlignment="Top"
                                       FontSize="9.5"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock x:Name="BalanceText"
                                       Text="--"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#EAF0F6" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2"
                            Padding="11,7"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <TextBlock x:Name="ResetCreditsCaption"
                                       Text="{loc:Str card.resetCredits}"
                                       VerticalAlignment="Top"
                                       FontSize="9.5"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock x:Name="ResetCreditsText"
                                       Text="--"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#EAF0F6" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LifetimeTokensCaption"
                                   Text="{loc:Str card.lifetimeTokens}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock x:Name="LifetimeTokensText"
                                   Text="--"
                                   Margin="0,2,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F7FA" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="LatestTokensCaption"
                                   Text="{loc:Str card.latestDay}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock x:Name="LatestTokensText"
                                   Text="--"
                                   Margin="0,2,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#DCE4EC" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Str card.sevenDay}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock x:Name="SevenDayTokensText"
                                   Text="--"
                                   Margin="0,2,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#DCE4EC" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{loc:Str card.dailyToken}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock x:Name="HistoryPeriodText"
                                   HorizontalAlignment="Right"
                                   FontSize="9.5"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </Grid>
                    <ItemsControl x:Name="HistoryItemsControl" Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="15" />
                                    </Grid.RowDefinitions>
                                     <Border Width="20"
                                             Height="{Binding BarHeight}"
                                             VerticalAlignment="Bottom"
                                             HorizontalAlignment="Center"
                                             Background="{Binding BarColor}"
                                             CornerRadius="3,3,1,1"
                                             Opacity="{Binding Opacity}"
                                             ToolTipService.InitialShowDelay="160"
                                             ToolTipService.BetweenShowDelay="0"
                                             ToolTipService.ShowDuration="12000"
                                             AutomationProperties.Name="{Binding AutomationLabel}">
                                        <Border.ToolTip>
                                            <ToolTip Style="{StaticResource HistoryBarToolTipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TooltipDate}"
                                                               FontSize="10"
                                                               Foreground="#9AA7B5" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding TooltipTokens}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F2F6FA" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DateLabel}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontSize="8.5"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TokenStatusText"
                               Text="{loc:Str status.readingToken}"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="UpdatedText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </Grid>

                <Border x:Name="HistoryPanel"
                        Grid.Row="12"
                        Margin="0,0,0,8"
                        Padding="11,9"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="HistoryTitleText"
                                       Text="{loc:Str history.title}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock x:Name="HistorySubtitleText"
                                       HorizontalAlignment="Right"
                                       FontSize="9.5"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,15,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Str history.colDate}"
                                       FontSize="9"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{loc:Str history.colShare}"
                                       FontSize="9"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="{loc:Str history.colToken}"
                                       FontSize="9"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,4,0">
                            <ItemsControl x:Name="HistoryListItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2"
                                              AutomationProperties.Name="{Binding AutomationLabel}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <Border Grid.Column="1"
                                                    Width="150"
                                                    Height="5"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="#18FFFFFF"
                                                    CornerRadius="2.5">
                                                <Border HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"
                                                        Background="{Binding BarColor}"
                                                        CornerRadius="2.5" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TokensLabel}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="86"
                                                       TextAlignment="Right"
                                                       FontSize="10"
                                                       Foreground="#DCE4EC" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="DetailsPanel"
                        Grid.Row="12"
                        Margin="0,0,0,8"
                        Padding="11,9"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <ItemsControl x:Name="DetailsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="0,0,0,3"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1"
                                                          AutomationProperties.Name="{Binding AutomationLabel}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="104" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value}"
                                                                   FontSize="10"
                                                                   Foreground="#DCE4EC"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="13"
                        Padding="3"
                        Background="#0FFFFFFF"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <UniformGrid Rows="1" Columns="2">
                        <RadioButton x:Name="CodexProviderTab"
                                     GroupName="UsageProvider"
                                     Tag="Codex"
                                     IsChecked="True"
                                     Style="{StaticResource ProviderTabStyle}"
                                     AutomationProperties.Name="{loc:Str tab.codex}"
                                     Checked="ProviderTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="#7EE787" />
                                <TextBlock Text="Codex"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ClaudeProviderTab"
                                     GroupName="UsageProvider"
                                     Tag="Claude"
                                     Style="{StaticResource ProviderTabStyle}"
                                     AutomationProperties.Name="{loc:Str tab.claude}"
                                     Checked="ProviderTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="#D9906E" />
                                <TextBlock Text="Claude"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
