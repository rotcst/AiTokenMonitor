<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiTokenMonitor</AssemblyName>
    <RootNamespace>CodexWeeklyMonitor</RootNamespace>
    <Version>1.8.2</Version>
    <Title>AI TOKEN 用量监控</Title>
    <Product>AI TOKEN 用量监控</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Window.Icon and the header badge both load this at runtime. -->
    <Resource Include="Assets\app.png" />
  </ItemGroup>
</Project>
