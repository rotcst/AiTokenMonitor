<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiTokenMonitor</AssemblyName>
    <RootNamespace>CodexWeeklyMonitor</RootNamespace>
    <Version>1.9.9</Version>
    <Title>AI TOKEN 用量监控</Title>
    <Product>AI TOKEN 用量监控</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DebugType>embedded</DebugType>
    <!--
      Never trim. DPAPI (ProtectedData) and AES-GCM decrypt the Claude desktop token cache via
      paths the trimmer can't see, so a trimmed single-file publish silently breaks credential
      reading (quota shows "not logged in" while local session data still works). Pinning this here
      means any `dotnet publish` is safe, not just ones that remember the flag.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      WPF depends on native rendering/subclassing libraries such as PresentationNative_cor3.dll.
      A single-file build that leaves those files beside the EXE will crash when only the EXE is
      distributed, so always embed the native libraries and let the runtime extract them safely.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <Target Name="ValidateSingleFileWpfPublish" BeforeTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(IncludeNativeLibrariesForSelfExtract)' != 'true'"
           Text="WPF single-file publishing requires IncludeNativeLibrariesForSelfExtract=true." />
  </Target>
  <ItemGroup>
    <!-- Window.Icon and the header badge both load this at runtime. -->
    <Resource Include="Assets\app.png" />
  </ItemGroup>
</Project>
