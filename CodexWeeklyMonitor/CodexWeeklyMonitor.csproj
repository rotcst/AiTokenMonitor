<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiTokenMonitor</AssemblyName>
    <RootNamespace>CodexWeeklyMonitor</RootNamespace>
    <Version>2.3.0</Version>
    <Title>AI TOKEN 用量监控</Title>
    <Product>AI TOKEN 用量监控</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DebugType>embedded</DebugType>
    <!--
      Never trim. DPAPI (ProtectedData) and AES-GCM decrypt the Claude desktop token cache via
      paths the trimmer can't see, so a trimmed single-file publish silently breaks credential
      reading (quota shows "not logged in" while local session data still works). Pinning this here
      means any `dotnet publish` is safe, not just ones that remember the flag.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      WPF depends on native rendering/subclassing libraries such as PresentationNative_cor3.dll.
      A single-file build that leaves those files beside the EXE will crash when only the EXE is
      distributed, so always embed the native libraries and let the runtime extract them safely.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Never compress. A compressed bundle has to be decompressed into memory at startup, so every
      assembly becomes private committed memory instead of a file-backed mapping the OS can share
      and page out. Measured on a real session: 368 MB working set / 229 MB private compressed
      against 243 MB / 151 MB uncompressed, for an EXE that grows 72 MB -> 165 MB. This app starts
      with Windows and sits in the tray all day, so the resident cost outweighs the download.
      IncludeAllContentForSelfExtract would give the same memory with a small EXE, but it leaves
      ~155 MB per version in %TEMP%\.net that nothing ever cleans up - with auto-updates that grows
      without bound. Pinned here so any `dotnet publish` is safe, not just ones that pass the flag.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <Target Name="ValidateSingleFileWpfPublish" BeforeTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(IncludeNativeLibrariesForSelfExtract)' != 'true'"
           Text="WPF single-file publishing requires IncludeNativeLibrariesForSelfExtract=true." />
    <Error Condition="'$(EnableCompressionInSingleFile)' == 'true'"
           Text="EnableCompressionInSingleFile costs ~125 MB of resident memory; see the comment on the property." />
  </Target>
  <ItemGroup>
    <!-- Window.Icon and the header badge both load this at runtime. -->
    <Resource Include="Assets\app.png" />
  </ItemGroup>
</Project>
