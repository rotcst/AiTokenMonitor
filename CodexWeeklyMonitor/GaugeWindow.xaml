<Window x:Class="CodexWeeklyMonitor.GaugeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexWeeklyMonitor"
        xmlns:loc="clr-namespace:CodexWeeklyMonitor.Localization"
        Title="AI Token"
        Width="{x:Static local:GaugeWindow.ShadowCanvasWidth}"
        Height="{x:Static local:GaugeWindow.ShadowCanvasHeight}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!--
        The larger transparent canvas is deliberate: WPF clips bitmap effects at the window boundary,
        so the orb's shadow needs real breathing room around it. Sizes derive from OrbDiameter.
    -->
    <Canvas x:Name="ShadowCanvas"
            ClipToBounds="False"
            ToolTip="{loc:Str gauge.restoreHint}">
        <!-- A wide, low-contrast ground shadow keeps the orb visually anchored without a hard edge. -->
        <Ellipse x:Name="GroundShadow"
                 Canvas.Left="{x:Static local:GaugeWindow.GroundShadowLeft}"
                 Canvas.Top="{x:Static local:GaugeWindow.GroundShadowTop}"
                 Width="{x:Static local:GaugeWindow.GroundShadowWidth}"
                 Height="{x:Static local:GaugeWindow.GroundShadowHeight}"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.42"
                                     GradientOrigin="0.5,0.42"
                                     RadiusX="0.5"
                                     RadiusY="0.5">
                    <GradientStop Offset="0" Color="#3A000000" />
                    <GradientStop Offset="0.58" Color="#1E000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Broad ambient penumbra: soft, shallow and intentionally low-opacity. -->
        <Ellipse x:Name="AmbientShadow"
                 Canvas.Left="{x:Static local:GaugeWindow.OrbOffsetX}"
                 Canvas.Top="{x:Static local:GaugeWindow.OrbOffsetY}"
                 Width="{x:Static local:GaugeWindow.OrbDiameter}"
                 Height="{x:Static local:GaugeWindow.OrbDiameter}"
                 Fill="#FF0E1117"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  ShadowDepth="4"
                                  Opacity="0.22"
                                  Color="#05070A"
                                  RenderingBias="Quality" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Tighter contact shadow adds depth under the lower rim without turning into a black ring. -->
        <Ellipse x:Name="ContactShadow"
                 Canvas.Left="{x:Static local:GaugeWindow.OrbOffsetX}"
                 Canvas.Top="{x:Static local:GaugeWindow.OrbOffsetY}"
                 Width="{x:Static local:GaugeWindow.OrbDiameter}"
                 Height="{x:Static local:GaugeWindow.OrbDiameter}"
                 Fill="#FF0E1117"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="9"
                                  Direction="270"
                                  ShadowDepth="7"
                                  Opacity="0.16"
                                  Color="#020305"
                                  RenderingBias="Quality" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid x:Name="OrbSurface"
              Canvas.Left="{x:Static local:GaugeWindow.OrbOffsetX}"
              Canvas.Top="{x:Static local:GaugeWindow.OrbOffsetY}"
              Width="{x:Static local:GaugeWindow.OrbDiameter}"
              Height="{x:Static local:GaugeWindow.OrbDiameter}">
            <Grid.ContextMenu>
                <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                             Opened="GaugeContextMenu_Opened">
                    <MenuItem Header="{loc:Str menu.showWindow}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              Click="RestoreMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource MenuIconStyle}"
                                  Data="M4 5h16v14H4z M4 9h16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="GaugeCheckUpdatesMenuItem"
                              Header="{loc:Str menu.checkUpdates}"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              Click="CheckUpdatesMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource MenuIconStyle}"
                                  Data="M12 3v12 M7 10l5 5 5-5 M5 21h14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{DynamicResource ModernMenuSeparatorStyle}" />
                    <MenuItem x:Name="GaugeTopmostMenuItem"
                              Header="{loc:Str menu.topmost}"
                              Style="{DynamicResource ModernMenuItemAccentStyle}"
                              IsCheckable="True"
                              Click="TopmostMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource MenuIconStyle}"
                                  Data="M9.5 3h5l-.6 6 2.6 2.8H7.5l2.6-2.8z M12 14.8V21" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{DynamicResource ModernMenuSeparatorStyle}" />
                    <MenuItem x:Name="GaugeVersionMenuItem"
                              Style="{DynamicResource ModernMenuItemStyle}"
                              IsEnabled="False" />
                </ContextMenu>
            </Grid.ContextMenu>
            <!-- Orb face: a domed dark disc (radial vignette) under a thin bright bezel. -->
            <Ellipse>
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.32"
                                         Center="0.5,0.42"
                                         RadiusX="0.75"
                                         RadiusY="0.75">
                        <GradientStop Offset="0" Color="#FF232935" />
                        <GradientStop Offset="0.72" Color="#FF161A22" />
                        <GradientStop Offset="1" Color="#FF0E1117" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Stroke="#2AFFFFFF"
                     StrokeThickness="1.2" />
            <ContentControl x:Name="GaugeHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>
    </Canvas>
</Window>
