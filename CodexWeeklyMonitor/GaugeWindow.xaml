<Window x:Class="CodexWeeklyMonitor.GaugeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CodexWeeklyMonitor.Localization"
        Title="AI Token"
        Width="212"
        Height="212"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid ToolTip="{loc:Str gauge.restoreHint}">
        <!-- Orb face: a domed dark disc (radial vignette) under a thin bright bezel. -->
        <Ellipse Margin="6">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.32" Center="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Offset="0" Color="#FF232935" />
                    <GradientStop Offset="0.72" Color="#FF161A22" />
                    <GradientStop Offset="1" Color="#FF0E1117" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="20"
                                  Direction="270"
                                  ShadowDepth="4"
                                  Opacity="0.5"
                                  Color="#000000" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Margin="6"
                 Stroke="#2AFFFFFF"
                 StrokeThickness="1.2" />
        <ContentControl x:Name="GaugeHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
    </Grid>
</Window>
